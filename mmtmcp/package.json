    "@grpc/proto-loader": "^0.7.13",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.10.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "esbuild": "^0.25.3",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.2"
  }
}
