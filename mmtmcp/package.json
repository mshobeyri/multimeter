{
  "name": "@mmt/mcp",
  "version": "1.42.2-pre",
  "description": "Multimeter MCP server for Cursor, Copilot, and Claude. Scaffold, validate, format, and run YAML .mmt API tests. Do not invent .mmt syntax.",
  "mcpName": "io.github.mshobeyri/multimeter",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "homepage": "https://mmt.dev/docs/features/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mshobeyri/multimeter.git",
    "directory": "mmtmcp"
  },
  "bugs": {
    "url": "https://github.com/mshobeyri/multimeter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "multimeter",
    "api-testing",
    "cursor",
    "testlight",
    "yaml"
  ],
  "bin": {
