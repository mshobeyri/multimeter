type: api
title: CountriesUsingCurrency
description: Countries that use a given currency ISO code
inputs:
  currency_iso: e:currency.iso
outputs:
  status: status
  countries: "body.soap:Envelope.soap:Body.m:CountriesUsingCurrencyResponse.m:CountriesUsingCurrencyResult.m:tCountryCodeAndName"
  first_iso: "body.soap:Envelope.soap:Body.m:CountriesUsingCurrencyResponse.m:CountriesUsingCurrencyResult.m:tCountryCodeAndName.0.m:sISOCode"
  first_name: "body.soap:Envelope.soap:Body.m:CountriesUsingCurrencyResponse.m:CountriesUsingCurrencyResult.m:tCountryCodeAndName.0.m:sName"
url: e:soap_url
method: post
format: xml
headers:
  Content-Type: text/xml; charset=utf-8
  SOAPAction: '""'
body:
  _declaration:
    _attributes:
      version: "1.0"
      encoding: utf-8
  soap:Envelope:
    _attributes:
      xmlns:soap: http://schemas.xmlsoap.org/soap/envelope/
    soap:Body:
      CountriesUsingCurrency:
        _attributes:
          xmlns: http://www.oorsprong.org/websamples.countryinfo
        sISOCurrencyCode: i:currency_iso
