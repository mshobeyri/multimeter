type: api
title: CountryISOCode
description: ISO country code for a country name
inputs:
  country_name: e:country.name
outputs:
  status: status
  iso: "body.soap:Envelope.soap:Body.m:CountryISOCodeResponse.m:CountryISOCodeResult"
url: e:soap_url
method: post
format: xml
headers:
  Content-Type: text/xml; charset=utf-8
  SOAPAction: '""'
body:
  _declaration:
    _attributes:
      version: "1.0"
      encoding: utf-8
  soap:Envelope:
    _attributes:
      xmlns:soap: http://schemas.xmlsoap.org/soap/envelope/
    soap:Body:
      CountryISOCode:
        _attributes:
          xmlns: http://www.oorsprong.org/websamples.countryinfo
        sCountryName: i:country_name
