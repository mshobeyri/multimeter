type: test
title: Elevation — near Everest
import:
  cities: +/cities.json
  api: +/api/elevation.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: ${cities.everest.latitude}
      longitude: ${cities.everest.longitude}
    expect:
      elevation_0:
        - >= 5000
        - <= 9000
    report: all
