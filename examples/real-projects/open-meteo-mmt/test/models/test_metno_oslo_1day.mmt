type: test
title: MET Norway — Oslo 1 day
import:
  api: +/api/model_metno.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: e:oslo_latitude
      longitude: e:oslo_longitude
      forecast_days: "1"
    expect:
      observed_at: =1d~ <<c:datetime>>
      resp_latitude:
        - >= 55
        - <= 65
      resp_longitude:
        - >= 5
        - <= 15
      hourly_count: >=# 24
    report: all
