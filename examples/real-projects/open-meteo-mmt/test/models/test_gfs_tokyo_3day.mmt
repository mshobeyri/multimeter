type: test
title: GFS — Tokyo 3 days
import:
  cities: +/cities.json
  api: +/api/model_gfs.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: ${cities.tokyo.latitude}
      longitude: ${cities.tokyo.longitude}
      forecast_days: "3"
    expect:
      observed_at: =1d~ <<c:datetime>>
      resp_latitude:
        - >= 30
        - <= 40
      resp_longitude:
        - >= 135
        - <= 145
      hourly_count: >=# 72
    report: all
