type: test
title: Météo-France — Paris 3 days
import:
  api: +/api/model_meteofrance.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: "48.85"
      longitude: "2.35"
      forecast_days: "3"
    expect:
      observed_at: =1d~ <<c:datetime>>
      resp_latitude:
        - >= 45
        - <= 52
      resp_longitude:
        - >= 0
        - <= 5
      hourly_count: >=# 72
    report: all
