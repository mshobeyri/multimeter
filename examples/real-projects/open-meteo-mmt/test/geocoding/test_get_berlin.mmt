type: test
title: Geocode get — Berlin id
import:
  cities: +/cities.json
  api: +/api/geocode_get.mmt
steps:
  - call: api
    id: result
    inputs:
      id: ${cities.berlin.geoname_id}
    expect:
      name: =C Berlin
      latitude:
        - >= 50
        - <= 55
      longitude: != null
      elevation: >= 0
    report: all
