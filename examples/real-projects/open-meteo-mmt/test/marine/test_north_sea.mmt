type: test
title: Marine — North Sea
import:
  cities: +/cities.json
  api: +/api/marine.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: ${cities.north_sea.latitude}
      longitude: ${cities.north_sea.longitude}
      forecast_days: "1"
    expect:
      hourly_time_0: =1d~ <<c:datetime>>
      wave_height_0: >= 0
      wave_direction_0:
        - >= 0
        - <= 360
    report: all
