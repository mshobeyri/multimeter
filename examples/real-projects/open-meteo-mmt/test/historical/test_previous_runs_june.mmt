type: test
title: Previous runs — June 2024
import:
  cities: +/cities.json
  api: +/api/previous_runs.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: ${cities.berlin.latitude}
      longitude: ${cities.berlin.longitude}
      start_date: e:history_start
      end_date: e:history_end
    expect:
      previous_day1_0:
        - >= -80
        - <= 60
      hourly_time_0: =^ e:history_start
    report: all
