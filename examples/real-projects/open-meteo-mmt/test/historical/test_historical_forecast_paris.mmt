type: test
title: Historical forecast — Paris June 2024
import:
  api: +/api/historical_forecast.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: "48.85"
      longitude: "2.35"
      start_date: e:history_start
      end_date: e:history_end
    expect:
      hourly_temp_0:
        - >= -80
        - <= 60
      hourly_time_0: =^ e:history_start
    report: all
