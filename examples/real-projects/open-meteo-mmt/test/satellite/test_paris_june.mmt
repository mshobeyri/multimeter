type: test
title: Satellite radiation — Paris June 2024
import:
  cities: +/cities.json
  api: +/api/satellite_radiation.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: ${cities.paris.latitude}
      longitude: ${cities.paris.longitude}
      start_date: e:history_start
      end_date: e:history_end
    expect:
      shortwave_0: >= 0
      hourly_time_0: =^ e:history_start
    report: all
