type: test
title: Satellite radiation — Berlin June 2024
import:
  api: +/api/satellite_radiation.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: e:latitude
      longitude: e:longitude
      start_date: e:history_start
      end_date: e:history_end
    expect:
      shortwave_0: >= 0
      hourly_time_0: =^ e:history_start
    report: all
