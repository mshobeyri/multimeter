type: test
title: Forecast current — Berlin
import:
  cities: +/cities.json
  api: +/api/forecast_current.mmt
steps:
  - call: api
    id: weather
    inputs:
      latitude: ${cities.berlin.latitude}
      longitude: ${cities.berlin.longitude}
    expect:
      observed_at: =1d~ <<c:datetime>>
      weather_code:
        - >= 0
        - <= 99
      wind_speed: >= 0
      temperature:
        - >= -80
        - <= 60
    report: all
