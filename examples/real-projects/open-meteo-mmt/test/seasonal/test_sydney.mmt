type: test
title: Seasonal — Sydney
import:
  cities: +/cities.json
  api: +/api/seasonal.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: ${cities.sydney.latitude}
      longitude: ${cities.sydney.longitude}
    expect:
      monthly_time_0: =40d~ <<c:date>>
      monthly_temp_0:
        - >= -80
        - <= 60
    report: all
