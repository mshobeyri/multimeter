type: test
title: Seasonal — Sydney
import:
  api: +/api/seasonal.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: e:sydney_latitude
      longitude: e:sydney_longitude
    expect:
      monthly_time_0: =40d~ <<c:date>>
      monthly_temp_0:
        - >= -80
        - <= 60
    report: all
