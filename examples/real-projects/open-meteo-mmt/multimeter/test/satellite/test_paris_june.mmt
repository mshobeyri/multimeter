type: test
title: Satellite radiation — Paris June 2024
import:
  cities: +/cities.json
  api: +/api/satellite_radiation.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: ${cities.paris.latitude}
      longitude: ${cities.paris.longitude}
      start_date: "2024-06-01"
      end_date: "2024-06-03"
    expect:
      shortwave_0: >= 0
      hourly_time_0: =^ 2024-06-01
    report: all
