type: test
title: Ensemble — Paris 1 day
import:
  cities: +/cities.json
  api: +/api/ensemble.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: ${cities.paris.latitude}
      longitude: ${cities.paris.longitude}
      forecast_days: "1"
    expect:
      hourly_time_0: =1d~ <<c:datetime>>
      temp_0:
        - >= -80
        - <= 60
    report: all
