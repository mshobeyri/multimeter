type: test
title: Historical forecast — Paris June 2024
import:
  cities: +/cities.json
  api: +/api/historical_forecast.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: ${cities.paris.latitude}
      longitude: ${cities.paris.longitude}
      start_date: "2024-06-01"
      end_date: "2024-06-03"
    expect:
      hourly_temp_0:
        - >= -80
        - <= 60
      hourly_time_0: =^ 2024-06-01
    report: all
