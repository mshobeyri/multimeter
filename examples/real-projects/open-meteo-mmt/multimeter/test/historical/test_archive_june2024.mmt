type: test
title: Archive — June 2024 Berlin
import:
  cities: +/cities.json
  api: +/api/archive.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: ${cities.berlin.latitude}
      longitude: ${cities.berlin.longitude}
      start_date: "2024-06-01"
      end_date: "2024-06-03"
    expect:
      daily_time_0: "2024-06-01"
      daily_time_last: "2024-06-03"
      hourly_time_0: =^ 2024-06-01
      daily_max_0:
        - >= -80
        - <= 60
      hourly_temp_0: != null
    report: all
  - check:
      actual: ${result.hourly_time_0}
      operator: =^
      expected: ${result.daily_time_0}
      report: all
