type: test
title: Flood — Berlin 3 day
import:
  cities: +/cities.json
  api: +/api/flood.mmt
steps:
  - call: api
    id: result
    inputs:
      latitude: ${cities.berlin.latitude}
      longitude: ${cities.berlin.longitude}
      forecast_days: "3"
    expect:
      daily_time_0: =2d~ <<c:date>>
      discharge_0: >= 0
    report: all
