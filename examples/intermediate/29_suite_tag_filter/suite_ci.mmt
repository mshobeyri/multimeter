type: suite
title: Suite tag filter — CI
description: Only smoke or api, then skip flaky. CLI --tag / --skip-tag replace this filter.
filter:
  only:
    - smoke
    - api
  skip:
    - flaky
items:
  - tests/smoke_get.mmt
  - tests/smoke_post.mmt
  - tests/api_echo.mmt
  - tests/flaky_echo.mmt
  - tests/slow_status.mmt
  - tests/untagged.mmt
  - nested/auth.mmt
