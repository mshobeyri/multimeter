type: test
title: Convert Example
description: Generated from Postman collection folder "Convert Example".
tags:
  - postman
import:
  ping: ../api/ping.mmt
steps:
  - call: ping
    id: iPing
    expect:
      status: 200
    debug: true
  # Postman `pm.*` is not available — Multimeter js using the step id instead.
  - js: |-
      check_(equals_(iPing.status, 200), 'check', 'iPing.status == 200', 'all', 'Ping (js)');
      console.log('Ping name:', iPing.name);
