type: api
title: Omit keyword
description: |-
  Use the `omit` keyword in inputs and see how it appears in outputs.

  Inputs:
  - `omit` (unquoted) removes the field from the request body
  - `null` (unquoted) sends JSON null
  - `"omit"` and `"null"` are literal strings

  Outputs:
  - missing path (for example `echoed_middle_name`) => omit
  - existing null value (for example `echoed_bio`) => null
inputs:
  display_name: Alex
  middle_name: omit
  nickname: "omit"
  bio: null
  bio_text: "null"
outputs:
  echoed_display_name: body.body.displayName
  echoed_middle_name: body.body.middleName
  echoed_nickname: body.body.nickname
  echoed_bio: body.body.bio
  echoed_bio_text: body.body.bioText
url: https://test.mmt.dev/echo
method: post
format: json
body:
  displayName: i:display_name
  middleName: i:middle_name
  nickname: i:nickname
  bio: i:bio
  bioText: i:bio_text