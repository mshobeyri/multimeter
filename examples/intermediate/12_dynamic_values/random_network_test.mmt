type: test
title: Random network
description: "Calls an API that uses network r: tokens"
import:
  randomNetwork: ./api/random_network.mmt
steps:
  - call: randomNetwork
    id: result
    expect:
      request_method: POST
      domain: =C .
      random_url: =^ https://
      mac: =* ^([0-9a-f]{2}:){5}[0-9a-f]{2}$
      user_agent: != null
      ip: '=* ^[0-9]{1,3}(.[0-9]{1,3}){3}$'
      hostname: =C .
