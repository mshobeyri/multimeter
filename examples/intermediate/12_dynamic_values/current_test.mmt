type: test
title: Current values
description: "Calls an API that uses c: tokens (clock, locale, git) and checks nearby times with =5s~"
import:
  currentValues: ./api/current.mmt
steps:
  - call: currentValues
    id: result
    expect:
      request_method: POST
      created_utc: =$ Z
      created_utc_plus_2s: =$ Z
      created_utc_plus_1h: =$ Z
      created_local: != null
      created_date: =^ 20
      created_time: '=* ^[0-9]{2}:[0-9]{2}:[0-9]{2}$'
      created_epoch: != null
      timezone: != null
      utc_offset: != null
      year: >= 2026
      git_branch: != null
      git_commit: =* ^([0-9a-f]{40})?$
      git_commit_short: =* ^([0-9a-f]{8})?$
      git_tag: != null
      git_describe: != null
      git_dirty: != null
  - check: ${result.created_utc} =5s~ ${result.created_utc_plus_2s}
  - check: ${result.created_utc} !5s~ ${result.created_utc_plus_1h}
