type: api
title: Random Echo
description: Sends random YAML tokens and extracts the echoed values from the response
outputs:
  random_id: body.body.id
  random_email: body.body.email
  random_name: body.body.name
  lucky_number: body.body.lucky_number
  active: body.body.active
  request_id: body.body.request_id
  bounded_int: body.body.bounded_int
  random_float: body.body.random_float
  short_code: body.body.short_code
  username: body.body.username
  password: body.body.password
  domain: body.body.domain
  random_url: body.body.random_url
  mac: body.body.mac
  user_agent: body.body.user_agent
  company: body.body.company
  job_title: body.body.job_title
  postal_code: body.body.postal_code
  street_address: body.body.street_address
  random_datetime: body.body.random_datetime
  random_utc_datetime: body.body.random_utc_datetime
  datetime_near_now: body.body.datetime_near_now
  utc_datetime_near_now: body.body.utc_datetime_near_now
  ranged_epoch: body.body.ranged_epoch
  epoch_near_now: body.body.epoch_near_now
  random_word: body.body.random_word
  random_sentence: body.body.random_sentence
  random_paragraph: body.body.random_paragraph
  request_method: body.method
url: https://test.mmt.dev/echo
method: post
format: json
body:
  id: r:uuid
  email: r:email
  name: r:first_name
  lucky_number: r:int
  active: r:bool
  request_id: req-<<r:uuid>>
  bounded_int: r:int(10,20)
  random_float: r:float(0,1)
  short_code: r:alphanumeric(12)
  username: r:username
  password: r:password(20)
  domain: r:domain
  random_url: r:url
  mac: r:mac
  user_agent: r:user_agent
  company: r:company
  job_title: r:job_title
  postal_code: r:postal_code
  street_address: r:street_address
  random_datetime: r:datetime(2026-01-01,2026-12-31)
  random_utc_datetime: r:utc_datetime(2026-01-01T00:00:00Z,2026-12-31T23:59:59Z)
  datetime_near_now: r:datetime_now(1h1m)
  utc_datetime_near_now: r:utc_datetime_now(1h1m)
  ranged_epoch: r:epoch(1700000000,1800000000)
  epoch_near_now: r:epoch_now(1h1m)
  random_word: r:word
  random_sentence: r:sentence
  random_paragraph: r:paragraph