@baseUrl = https://test.mmt.dev
@username = test_user
@password = 1234

########################################
### 1. LOGIN (capture token)
########################################
POST {{baseUrl}}/echo
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}",
  "token": "testtoken"
}

> {%
  client.test("Login successful", function () {
    client.assert(response.status === 200);
  });

  client.test("Token exists", function () {
    client.assert(response.body.body.token !== undefined);
  });

  client.global.set("authToken", "testtoken");
%}


########################################
### 2. CREATE USER (POST)
########################################
POST {{baseUrl}}/echo
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Ali",
  "email": "ali@example.com",
  "id": 42
}

> {%
  client.test("User created", function () {
    client.assert(response.status === 200);
  });

  client.test("Name matches input", function () {
    client.assert(response.body.body.name === "Ali");
  });

  client.global.set("userId", 42);
%}


########################################
### 3. GET USER (GET + validation)
########################################
GET {{baseUrl}}/auth/bearer
Authorization: Bearer {{authToken}}

> {%
  client.test("User fetched", function () {
    client.assert(response.status === 200);
  });

  client.test("Bearer authenticated", function () {
    client.assert(response.body.authenticated === true);
  });
%}


########################################
### 4. UPDATE USER (PATCH)
########################################
PATCH {{baseUrl}}/echo
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Ali Updated",
  "id": {{userId}}
}

> {%
  client.test("Update success", function () {
    client.assert(response.status === 200);
  });

  client.test("Name updated", function () {
    client.assert(response.body.body.name === "Ali Updated");
  });
%}


########################################
### 5. DELETE USER
########################################
DELETE {{baseUrl}}/status/200
Authorization: Bearer {{authToken}}

> {%
  client.test("Deleted successfully", function () {
    client.assert(response.status === 200);
  });
%}
