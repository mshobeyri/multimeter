type: test
title: "test_02"
description: "Stress test 23 — many HTTP calls and verbose checks to inflate suite run reports"
steps:
  - http: https://test.mmt.dev/json
    id: s1
    title: "Memory stress probe — verify JSON payload fields, response headers, and timing metadata for suite report spill testing. Segment 23.1 — GET json baseline"
    method: get
    expect:
      status: 200
  - check: ${s1.status} == 200
    title: "Memory stress probe — verify JSON payload fields, response headers, and timing metadata for suite report spill testing. Segment 23.1 — GET json baseline — status code must remain 200 after suite routing and spill reload"
  - check: ${s1.body} != ""
    title: "Memory stress probe — verify JSON payload fields, response headers, and timing metadata for suite report spill testing. Segment 23.1 — GET json baseline — response message body must be non-empty for report detail panels"
  - check: ${s1.headers} != ""
    title: "Memory stress probe — verify JSON payload fields, response headers, and timing metadata for suite report spill testing. Segment 23.1 — GET json baseline — response headers must be present for report detail panels and spill reload"
