type: test
title: "test_05"
description: "Stress test 5 — many HTTP calls and verbose checks to inflate suite run reports"
steps:
  - http: https://test.mmt.dev/json
    id: s1
    title: "Memory stress probe — verify JSON payload fields, response headers, and timing metadata for suite report spill testing. Segment 5.1 — GET json baseline"
    method: get
    expect:
      status: 200
    report: all
  - check: ${s1.status} == 200
    title: "Memory stress probe — verify JSON payload fields, response headers, and timing metadata for suite report spill testing. Segment 5.1 — GET json baseline — status code must remain 200 after suite routing and spill reload"
    report: all
  - check: ${s1.body} != ""
    title: "Memory stress probe — verify JSON payload fields, response headers, and timing metadata for suite report spill testing. Segment 5.1 — GET json baseline — response message body must be non-empty for report detail panels"
    report: all
  - check: ${s1.headers} != ""
    title: "Memory stress probe — verify JSON payload fields, response headers, and timing metadata for suite report spill testing. Segment 5.1 — GET json baseline — response headers must be present for report detail panels and spill reload"
    report: all
