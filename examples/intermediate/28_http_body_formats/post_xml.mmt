type: api
title: POST XML body
description: YAML object converted to XML with self-closing empty tags (format xml).
inputs:
  name: ada
outputs:
  echoed_name: body[/<name>(.*?)</name>/]
  status_code: status
url: https://test.mmt.dev/echo
method: post
format: xml
body:
  user:
    name: i:name
    meta: {}
