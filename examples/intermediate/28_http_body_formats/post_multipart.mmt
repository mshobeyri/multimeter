type: api
title: POST multipart body
description: multipart/form-data with a text field and a file part from ./assets/sample.txt.
inputs:
  description: hello from multipart
outputs:
  echoed_description: body[body][description]
  echoed_filename: body[body][file][filename]
  echoed_file: body[body][file][content]
  request_content_type: body[headers][content-type]
  status_code: status
url: https://test.mmt.dev/echo
method: post
format: multipart
# Each list item is one form part: `value` for text, `file` for a path relative to this .mmt file.
body:
  - name: description
    value: i:description
  - name: file
    file: ./assets/sample.txt
