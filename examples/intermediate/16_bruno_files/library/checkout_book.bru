meta {
  name: Checkout book
  type: http
  seq: 4
}

docs {
  Checkout a loan. The sandbox echoes the JSON body and query.
}

post {
  url: {{baseUrl}}/echo
  body: json
  auth: bearer
}

vars:pre-request {
  baseUrl: https://test.mmt.dev
  authToken: demo-token
  memberId: mem-17
  bookTitle: The Name of the Wind
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-Client: multimeter-bruno
}

params:query {
  source: library
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "action": "checkout",
    "book": {
      "id": 42,
      "title": "{{bookTitle}}"
    },
    "memberId": "{{memberId}}",
    "days": 21
  }
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.body.action).to.equal("checkout");
  expect(res.body.body.memberId).to.equal("mem-17");
  expect(res.body.query.source).to.equal("library");
}
