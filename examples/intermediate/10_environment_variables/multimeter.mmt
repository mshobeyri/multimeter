type: env
variables:
  api_url:
    local: "https://local.mmt.dev"
    staging: "https://test.mmt.dev"
  mode:
    dev: debug
    prod: release
  timeout:
    - 5000
    - 10000
    - 30000
  # OS process env — PATH exists on macOS, Linux, and Windows
  path_from_os: $PATH
  # Live file-backed values (run on each e: read)
  session_api: ./live_variables/create_session_api.mmt
  session_test: ./live_variables/create_session_test.mmt
presets:
  runner:
    dev:
      api_url: local
      mode: dev
      timeout: 5000
    staging:
      api_url: staging
      mode: prod
      timeout: 10000
