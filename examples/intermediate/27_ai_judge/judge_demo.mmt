type: test
title: AI judge demo
description: |
  Evaluates a sample reply with soft expect and hard require
  (one report box). Uses Gemini by default; switch the judge step
  to ollama for a local model — see README.md.
import:
  gemini: ./judges/gemini.mmt
  ollama: ./judges/ollama.mmt
steps:
  - const:
      reply: "Yes. Under our policy you may return the item within 30 days of purchase."
      expected: "The customer can return the product within 30 days."
      policy: "Returns accepted within 30 days of purchase with receipt."

  - judge: gemini
    id: j1
    title: Return-policy reply quality
    context:
      actual: ${reply}
      expected: ${expected}
      policy: ${policy}
    expect:
      answerRelevance: 0.75
      semanticSimilarity: 0.75
      criteria:
        - The response should answer whether a return is allowed.
        - The response should be concise.
    require:
      contextFaithfulness: 0.50
      semanticSimilarity: 0.50

  - print: "judge passed=${j1.passed}"
