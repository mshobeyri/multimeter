type: api
title: Bearer auth check
description: |
  Requires `Authorization: Bearer testtoken`. Any other token fails.
url: https://test.mmt.dev/auth/bearer
method: get
format: json
auth:
  type: bearer
  token: i:token
examples:
  - id: "200"
    title: "200"
    expect:
      status: 200
      body:
        authenticated: true
        token: testtoken
