type: api
title: Echo POST body
description: Echoes method, URL, headers, body, and a timestamp.
inputs:
  body_name: omit
  body_role: omit
  body_order_id: omit
  body_order_items: omit
url: https://test.mmt.dev/echo
method: post
format: json
headers:
  X-Trace: demo
  Content-Type: application/json
body:
  name: <<i:body_name>>
  role: <<i:body_role>>
  order:
    id: <<i:body_order_id>>
    items: <<i:body_order_items>>
examples:
  - id: User profile
    title: User profile
    description: Simple JSON object
    inputs:
      body_name: Ada
      body_role: engineer
    expect:
      status: 200
      body:
        method: POST
        url: https://test.mmt.dev/echo
        path: /echo
        body:
          name: Ada
          role: engineer
        timestamp: 2026-01-01T00:00:00.000Z
  - id: Nested payload
    title: Nested payload
    inputs:
      body_order_id: 1001
      body_order_items:
        - sku: ABC
          qty: 2
    expect:
      status: 200
      body:
        method: POST
        url: https://test.mmt.dev/echo
        path: /echo
        body:
          order:
            id: 1001
            items:
              - sku: ABC
                qty: 2
        timestamp: 2026-01-01T00:00:00.000Z
  - id: Empty object
    title: Empty object
    expect:
      status: 200
      body:
        method: POST
        url: https://test.mmt.dev/echo
        path: /echo
        body: {}
        timestamp: 2026-01-01T00:00:00.000Z
