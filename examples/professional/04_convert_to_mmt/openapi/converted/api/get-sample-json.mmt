type: api
title: Get sample JSON
description: Returns a fixed Multimeter sample JSON object.
url: https://test.mmt.dev/json
method: get
format: json
examples:
  - id: "200"
    title: "200"
    expect:
      status: 200
      body:
        id: 1
        name: Multimeter
        description: API testing tool
        version: 1.0.0
        tags:
          - api
          - testing
          - automation
        nested:
          enabled: true
          count: 42
          items:
            - key: alpha
              value: 1
            - key: beta
              value: 2
