type: api
title: EchoMessage
inputs:
  message: string
  role: string
url: https://test.mmt.dev/xml
protocol: http
method: post
format: xml
headers:
  Content-Type: text/xml; charset=utf-8
  SOAPAction: urn:EchoMessage
body: |-
  <?xml version="1.0" encoding="utf-8"?>
  <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tns="urn:mmt-test">
    <soapenv:Header/>
    <soapenv:Body>
      <tns:EchoMessage>
          <tns:message><<i:message>></tns:message>
          <tns:role><<i:role>></tns:role>
      </tns:EchoMessage>
    </soapenv:Body>
  </soapenv:Envelope>
