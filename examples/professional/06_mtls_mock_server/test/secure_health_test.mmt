type: test
title: mTLS Mock Server Test
description: Starts an mTLS mock server and calls it with the configured CA and client certificate
import:
  server: ../server/mock_server.mmt
  health: ../api/secure_health.mmt
steps:
  - run: server
  - call: health
    id: result
    expect:
      status_code: 200
      status_field: ok
      transport: mtls
    report: all
