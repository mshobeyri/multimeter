type: test
title: Env token resolution
description: "Echoes e: values. JSON keeps the environment type. XML, form, headers, and query send text."
import:
  jsonBody: ../api/env_json_body.mmt
  xmlBody: ../api/env_xml_body.mmt
  formBody: ../api/env_urlencoded_body.mmt
  headerApi: ../api/env_header.mmt
  queryApi: ../api/env_query.mmt
steps:
  - call: jsonBody
    id: json_body
    expect:
      status_code: 200
      account_age: 42
      feature_enabled: true
      plan_code: 10
      plan_label: "10"
      service_url: https://test.mmt.dev
      missing_region: "e:region"
      literal_token: "e:account_age"
      literal_omit: "omit"
      removed_note: omit
      angle_whole: 42
      quoted_angle: "42"
      angle_prefix: "asda42"
      angle_suffix: "42asas"
      angle_both: "asdatrueasas"
      quoted_curly: "{{42}}"
      curly_whole: "10"
      text_slice: "https://"
      missing_embed: "xe:regiony"
  - call: xmlBody
    id: xml_body
    expect:
      status_code: 200
      account_age: "42"
      feature_enabled: "true"
      plan_code: "10"
      plan_label: "10"
      service_url: https://test.mmt.dev
      missing_region: "e:region"
      literal_token: "e:account_age"
      literal_omit: "omit"
      angle_whole: "42"
      quoted_angle: "&lt;&lt;42&gt;&gt;"
      angle_prefix: "asda42"
      angle_suffix: "42asas"
      angle_both: "asdatrueasas"
      quoted_curly: "{{42}}"
      curly_whole: "10"
      text_slice: "https://"
      missing_embed: "xe:regiony"
  - call: formBody
    id: form_body
    expect:
      status_code: 200
      account_age: "42"
      feature_enabled: "true"
      plan_code: "10"
      plan_label: "10"
      service_url: https://test.mmt.dev
      missing_region: "e:region"
      literal_token: "e:account_age"
      literal_omit: "omit"
      angle_whole: "42"
      quoted_angle:
        - '=^ "<<"'
        - '=C "e:"'
        - '=C account_age'
        - '=$ ">>"'
      angle_prefix: "asda42"
      angle_suffix: "42asas"
      angle_both: "asdatrueasas"
      quoted_curly: "{{42}}"
      curly_whole: "10"
      text_slice: "https://"
      missing_embed: "xe:regiony"
  - call: headerApi
    id: header_call
    expect:
      status_code: 200
      account_age: "42"
      feature_enabled: "true"
      plan_code: "10"
      plan_label: "10"
      service_url: https://test.mmt.dev
      missing_region: "e:region"
      literal_token: "e:account_age"
      literal_omit: "omit"
      angle_whole: "42"
      quoted_angle: envVariables.account_age
      angle_prefix: "asda42"
      angle_suffix: "42asas"
      angle_both: "asdatrueasas"
      quoted_curly: "{{envVariables.account_age}}"
      curly_whole: "10"
      text_slice: "https://"
      missing_embed: "xe:regiony"
  - call: queryApi
    id: query_call
    expect:
      status_code: 200
      account_age: "42"
      feature_enabled: "true"
      plan_code: "10"
      plan_label: "10"
      service_url: https://test.mmt.dev
      missing_region: "e:region"
      literal_token: "e:account_age"
      literal_omit: "omit"

      angle_whole: "42"
      quoted_angle: envVariables.account_age
      angle_prefix: "asda42"
      angle_suffix: "42asas"
      angle_both: "asdatrueasas"
      quoted_curly: "{{envVariables.account_age}}"
      curly_whole: "10"
      text_slice: "https://"
      missing_embed: "xe:regiony"
