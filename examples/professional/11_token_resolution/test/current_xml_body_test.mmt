type: test
title: Current token resolution (XML body)
description: "Echoes c: values as XML text."
import:
  api: ../api/current_xml_body.mmt
steps:
  - call: api
    id: call
    expect:
      status_code: 200
      day_name: != null
      epoch_seconds: != null
      city: != null
      missing_token: "c:not_a_token"
      literal_token: "c:day"
      literal_omit: "omit"
      angle_whole: "=* ^[0-9]{10}$"
      quoted_angle: c:day
      angle_prefix: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)$
      angle_suffix: =$ asas
      angle_both: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)asas$
      quoted_curly: c:day
      curly_whole: "!= null"
      text_slice: "=# 1"
