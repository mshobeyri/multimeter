type: test
title: Random token resolution (JSON body)
description: "Echoes r: values in JSON. uuid stays text, int a number, bool a boolean."
import:
  api: ../api/random_json_body.mmt
steps:
  - call: api
    id: call
    expect:
      status_code: 200
      request_id: != null
      lucky_number:
        - >= 10
        - <= 20
      active: != null
      missing_token: "r:not_a_token"
      literal_token: "r:uuid"
      literal_omit: "omit"
      removed_note: omit
      angle_whole:
        - ">= 10"
        - <= 20
      quoted_angle:
        - ">= 10"
        - <= 20
      angle_prefix: =* ^asda(1[0-9]|20)$
      angle_suffix: =* ^(1[0-9]|20)asas$
      angle_both: =* ^asda(true|false)asas$
      quoted_curly:
        - "=^ \"{{\""
        - "!C r:"
      curly_whole:
        - "!= null"
        - "!C r:"
      missing_embed: "xr:not_a_tokeny"
