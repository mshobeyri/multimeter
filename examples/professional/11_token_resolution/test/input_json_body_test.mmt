type: test
title: Input token resolution (JSON body)
description: "Echoes i: values in JSON. Keeps the input type (age is 100, active is true)."
import:
  api: ../api/input_json_body.mmt
steps:
  - call: api
    id: call
    expect:
      status_code: 200
      username: alice
      age: 100
      active: true
      city: Berlin
      missing_nickname: "i:nickname"
      literal_token: "i:username"
      literal_omit: "omit"
      removed_note: omit
      angle_whole: 100
      quoted_angle: "<<i:username>>"
      angle_prefix: "asdaalice"
      angle_suffix: "100asas"
      angle_both: "asdatrueasas"
      quoted_curly: "{{i:username}}"
      curly_whole: "Berlin"
      text_slice: "Ber"
      missing_embed: "xi:nicknamey"
