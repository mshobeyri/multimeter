type: test
title: Random token resolution (header)
description: "Echoes r: values as header text (r:color stays a name)."
import:
  api: ../api/random_header.mmt
steps:
  - call: api
    id: call
    expect:
      status_code: 200
      request_id: != null
      lucky_number: != null
      color: != null
      missing_token: "r:not_a_token"
      literal_token: "r:uuid"
      literal_omit: "omit"
      angle_whole: =* ^(1[0-9]|20)$
      quoted_angle: "<<r:int(10,20)>>"
      angle_prefix: =* ^asda(1[0-9]|20)$
      angle_suffix: =* ^(1[0-9]|20)asas$
      angle_both: =* ^asda(true|false)asas$
      quoted_curly: "{{r:color}}"
      curly_whole:
        - "!= null"
        - "!C r:"
      missing_embed: "xr:not_a_tokeny"
