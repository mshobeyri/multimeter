type: test
title: Current token resolution (JSON body)
description: "Echoes c: values in JSON. c:epoch stays a number. c:git_dirty stays a boolean. Clock, locale, and git strings stay text."
import:
  api: ../api/current_json_body.mmt
steps:
  - call: api
    id: call
    expect:
      status_code: 200
      day_name: != null
      epoch_seconds: > 1700000000
      city: != null
      git_branch: != null
      git_commit: =* ^([0-9a-f]{8})?$
      git_commit_hash: =* ^([0-9a-f]{7,40})?$
      git_tag: != null
      git_describe: != null
      git_dirty: != null
      commit_alias: c:git_commit
      missing_token: "c:not_a_token"
      literal_token: "c:day"
      literal_omit: "omit"
      removed_note: omit
      angle_whole: "> 1700000000"
      quoted_angle: c:day
      angle_prefix: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)$
      angle_suffix: =$ asas
      angle_both: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)asas$
      quoted_curly: c:day
      curly_whole: "!= null"
      text_slice: "=# 1"
      missing_embed: "xc:not_a_tokeny"
  - check: ${call.commit_alias} == ${call.git_commit}
