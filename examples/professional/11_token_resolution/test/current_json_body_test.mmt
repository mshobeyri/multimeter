type: test
title: Current token resolution (JSON body)
description: "Echoes c: values in JSON. c:epoch stays a number. c:day and c:city stay text."
import:
  api: ../api/current_json_body.mmt
steps:
  - call: api
    id: call
    expect:
      status_code: 200
      day_name: != null
      epoch_seconds: > 1700000000
      city: != null
      missing_token: "c:not_a_token"
      literal_token: "c:day"
      literal_omit: "omit"
      removed_note: omit
      angle_whole: "> 1700000000"
      quoted_angle: c:day
      angle_prefix: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)$
      angle_suffix: =$ asas
      angle_both: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)asas$
      quoted_curly: c:day
      curly_whole: "!= null"
      text_slice: "=# 1"
      missing_embed: "xc:not_a_tokeny"
