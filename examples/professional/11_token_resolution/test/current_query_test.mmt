type: test
title: Current token resolution (query)
description: "Echoes c: clock, locale, and git values as query text."
import:
  api: ../api/current_query.mmt
steps:
  - call: api
    id: call
    expect:
      status_code: 200
      day_name: != null
      epoch_seconds: != null
      city: != null
      git_branch: != null
      git_commit: =* ^([0-9a-f]{8})?$
      git_commit_hash: =* ^([0-9a-f]{7,40})?$
      git_describe: != null
      git_dirty: =* ^(true|false)$
      commit_alias: c:git_commit
      missing_token: "c:not_a_token"
      literal_token: "c:day"
      literal_omit: "omit"
      angle_whole: "=* ^[0-9]{10}$"
      quoted_angle: c:day
      angle_prefix: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)$
      angle_suffix: =$ asas
      angle_both: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)asas$
      quoted_curly: c:day
      curly_whole: "!= null"
      text_slice: "=# 1"
      missing_embed: "xc:not_a_tokeny"
  - check: ${call.commit_alias} == ${call.git_commit}
