type: test
title: Input token resolution (XML body)
description: "Echoes i: values as XML text."
import:
  api: ../api/input_xml_body.mmt
inputs:
  username: alice
steps:
  - call: api
    id: call
    expect:
      status_code: 200
      username: i:username
      age: "100"
      active: "true"
      city: Berlin
      missing_nickname: "i:nickname"
      literal_token: "i:username"
      literal_omit: "omit"
      angle_whole: "100"
      quoted_angle: i:username
      angle_prefix: "asdaalice"
      angle_suffix: "100asas"
      angle_both: "asdatrueasas"
      quoted_curly: i:username
      curly_whole: "Berlin"
      text_slice: "Ber"
      missing_embed: "xi:nicknamey"
      attr_number: "100"
      attr_bool: "true"
      attr_text: "1.0"
      attr_angle: "100"
      attr_embedded: "n100"
      attr_literal: "1.0"
      attr_decimal: "9.5"
      price_text: "9.5"
