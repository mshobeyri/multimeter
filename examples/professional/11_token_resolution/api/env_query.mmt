type: api
title: Env tokens in the query string
description: Query values are strings. A number env value is sent as its text.
outputs:
  account_age: body.query.account_age
  feature_enabled: body.query.feature_enabled
  plan_code: body.query.plan_code
  plan_label: body.query.plan_label
  service_url: body.query.service_url
  missing_region: body.query.missing_region
  literal_token: body.query.literal_token
  literal_omit: body.query.literal_omit
  angle_whole: body.query.angle_whole
  quoted_angle: body.query.quoted_angle
  angle_prefix: body.query.angle_prefix
  angle_suffix: body.query.angle_suffix
  angle_both: body.query.angle_both
  quoted_curly: body.query.quoted_curly
  curly_whole: body.query.curly_whole
  text_slice: body.query.text_slice
  missing_embed: body.query.missing_embed
  status_code: status
url: https://test.mmt.dev/echo
method: get
query:
  account_age: e:account_age
  feature_enabled: e:feature_enabled
  plan_code: e:plan_code
  plan_label: e:plan_label
  service_url: e:service_url
  missing_region: e:region
  literal_token: "e:account_age"
  literal_omit: "omit"
  angle_whole: <<e:account_age>>
  quoted_angle: "<<e:account_age>>"
  angle_prefix: "asda<<e:account_age>>"
  angle_suffix: "<<e:account_age>>asas"
  angle_both: "asda<<e:feature_enabled>>asas"
  quoted_curly: "{{e:account_age}}"
  curly_whole: {{e:plan_label}}
  text_slice: <<e:service_url[0:8]>>
  missing_embed: "x<<e:region>>y"
examples:
  - id: defaults
    title: Check outputs
    expect:
      status_code: 200
      account_age: "42"
      feature_enabled: "true"
      plan_code: "10"
      plan_label: "10"
      service_url: https://test.mmt.dev
      missing_region: "e:region"
      literal_token: "e:account_age"
      literal_omit: "omit"
      angle_whole: "42"
      quoted_angle: "<<e:account_age>>"
      angle_prefix: "asda42"
      angle_suffix: "42asas"
      angle_both: "asdatrueasas"
      quoted_curly: "{{e:account_age}}"
      curly_whole: "10"
      text_slice: "https://"
      missing_embed: "xe:regiony"
