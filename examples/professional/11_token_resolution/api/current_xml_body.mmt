type: api
title: Current tokens in an XML body
description: "XML element text is always a string, including c:epoch and c:git_dirty."
outputs:
  day_name: body.echo.body.body.day_name
  epoch_seconds: body.echo.body.body.epoch_seconds
  city: body.echo.body.body.city
  git_branch: body.echo.body.body.git_branch
  git_commit: body.echo.body.body.git_commit
  git_commit_short: body.echo.body.body.git_commit_short
  git_describe: body.echo.body.body.git_describe
  git_dirty: body.echo.body.body.git_dirty
  missing_token: body.echo.body.body.missing_token
  literal_token: body.echo.body.body.literal_token
  literal_omit: body.echo.body.body.literal_omit
  angle_whole: body.echo.body.body.angle_whole
  quoted_angle: body.echo.body.body.quoted_angle
  angle_prefix: body.echo.body.body.angle_prefix
  angle_suffix: body.echo.body.body.angle_suffix
  angle_both: body.echo.body.body.angle_both
  quoted_curly: body.echo.body.body.quoted_curly
  curly_whole: body.echo.body.body.curly_whole
  text_slice: body.echo.body.body.text_slice
  status_code: status
url: https://test.mmt.dev/echo/xml
method: post
format: xml
body:
  body:
    day_name: c:day
    epoch_seconds: c:epoch
    city: c:city
    git_branch: c:branch
    git_commit: c:commit
    git_commit_short: c:commit_short
    git_describe: c:git_describe
    git_dirty: c:git_dirty
    missing_token: c:not_a_token
    literal_token: "c:day"
    literal_omit: "omit"
    angle_whole: <<c:epoch>>
    quoted_angle: "<<c:day>>"
    angle_prefix: "asda<<c:day>>"
    angle_suffix: "<<c:city>>asas"
    angle_both: "asda<<c:day>>asas"
    quoted_curly: "{{c:day}}"
    curly_whole: {{c:city}}
    text_slice: <<c:city[0:1]>>
examples:
  - id: defaults
    title: Check outputs
    expect:
      status_code: 200
      day_name: c:day
      epoch_seconds: != null
      city: c:city
      git_branch: c:branch
      git_commit: c:commit
      git_commit_short: c:commit_short
      git_describe: c:git_describe
      git_dirty: c:git_dirty
      missing_token: "c:not_a_token"
      literal_token: "c:day"
      literal_omit: "omit"
      angle_whole: "=* ^[0-9]{10}$"
      quoted_angle: c:day
      angle_prefix: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)$
      angle_suffix: =$ asas
      angle_both: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)asas$
      quoted_curly: c:day
      curly_whole: c:city
      text_slice: c:city[0:1]
