type: api
title: Current tokens in an XML body
description: "XML element text is always a string, including c:epoch."
outputs:
  day_name: body[/<day_name>(.*?)</day_name>/]
  epoch_seconds: body[/<epoch_seconds>(.*?)</epoch_seconds>/]
  city: body[/<city>(.*?)</city>/]
  missing_token: body[/<missing_token>(.*?)</missing_token>/]
  literal_token: body[/<literal_token>(.*?)</literal_token>/]
  literal_omit: body[/<literal_omit>(.*?)</literal_omit>/]
  angle_whole: body[/<angle_whole>(.*?)</angle_whole>/]
  quoted_angle: body[/<quoted_angle>(.*?)</quoted_angle>/]
  angle_prefix: body[/<angle_prefix>(.*?)</angle_prefix>/]
  angle_suffix: body[/<angle_suffix>(.*?)</angle_suffix>/]
  angle_both: body[/<angle_both>(.*?)</angle_both>/]
  quoted_curly: body[/<quoted_curly>(.*?)</quoted_curly>/]
  curly_whole: body[/<curly_whole>(.*?)</curly_whole>/]
  text_slice: body[/<text_slice>(.*?)</text_slice>/]
  missing_embed: body[/<missing_embed>(.*?)</missing_embed>/]
  status_code: status
url: https://test.mmt.dev/echo
method: post
format: xml
body:
  day_name: c:day
  epoch_seconds: c:epoch
  city: c:city
  missing_token: c:not_a_token
  literal_token: "c:day"
  literal_omit: "omit"
  angle_whole: <<c:epoch>>
  quoted_angle: "<<c:day>>"
  angle_prefix: "asda<<c:day>>"
  angle_suffix: "<<c:city>>asas"
  angle_both: "asda<<c:day>>asas"
  quoted_curly: "{{c:day}}"
  curly_whole: {{c:city}}
  text_slice: <<c:city[0:1]>>
  missing_embed: "x<<c:not_a_token>>y"
examples:
  - id: defaults
    title: Check outputs
    expect:
      status_code: 200
      day_name: != null
      epoch_seconds: != null
      city: != null
      missing_token: "c:not_a_token"
      literal_token: "c:day"
      literal_omit: "omit"
      angle_whole: "=* ^[0-9]{10}$"
      quoted_angle: "=* ^&lt;&lt;(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)&gt;&gt;$"
      angle_prefix: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)$
      angle_suffix: =$ asas
      angle_both: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)asas$
      quoted_curly: "=* ^\\{\\{(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)\\}\\}$"
      curly_whole: "!= null"
      text_slice: "=# 1"
      missing_embed: "xc:not_a_tokeny"
