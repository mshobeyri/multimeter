type: api
title: Input tokens in a JSON body
description: "A whole-field i: value keeps the input type. Quoted <<i:username>> and {{i:username}} resolve to the input. The example expects i:username. A quoted bare token is text. A missing input is sent as i:nickname."
inputs:
  username: alice
  age: 100
  active: true
  city: Berlin
  version: "1.0"
  price: 9.5
outputs:
  username: body.body.username
  age: body.body.age
  active: body.body.active
  city: body.body.city
  missing_nickname: body.body.missing_nickname
  literal_token: body.body.literal_token
  literal_omit: body.body.literal_omit
  removed_note: body.body.removed_note
  angle_whole: body.body.angle_whole
  quoted_angle: body.body.quoted_angle
  angle_prefix: body.body.angle_prefix
  angle_suffix: body.body.angle_suffix
  angle_both: body.body.angle_both
  quoted_curly: body.body.quoted_curly
  curly_whole: body.body.curly_whole
  text_slice: body.body.text_slice
  missing_embed: body.body.missing_embed
  version_text: body.body.version
  price_value: body.body.price
  status_code: status
url: https://test.mmt.dev/echo
method: post
format: json
body:
  username: i:username
  age: i:age
  active: i:active
  city: i:city
  missing_nickname: i:nickname
  literal_token: "i:username"
  removed_note: omit
  literal_omit: "omit"
  angle_whole: <<i:age>>
  quoted_angle: "<<i:username>>"
  angle_prefix: "asda<<i:username>>"
  angle_suffix: "<<i:age>>asas"
  angle_both: "asda<<i:active>>asas"
  quoted_curly: "{{i:username}}"
  curly_whole: {{i:city}}
  text_slice: <<i:city[0:3]>>
  missing_embed: "x<<i:nickname>>y"
  version: i:version
  price: i:price
examples:
  - id: defaults
    title: Check outputs
    expect:
      status_code: 200
      username: i:username
      age: i:age
      active: i:active
      city: i:city
      missing_nickname: "i:nickname"
      literal_token: "i:username"
      literal_omit: "omit"
      removed_note: omit
      angle_whole: i:age
      quoted_angle: i:username
      angle_prefix: "asdaalice"
      angle_suffix: "100asas"
      angle_both: "asdatrueasas"
      quoted_curly: i:username
      curly_whole: i:city
      text_slice: i:city[0:3]
      missing_embed: "xi:nicknamey"
      version_text: "1.0"
      price_value: 9.5
