type: api
title: Input tokens in an XML body
description: XML element text is always a string, including numeric and boolean inputs.
inputs:
  username: alice
  age: 100
  active: true
  city: Berlin
  version: "1.0"
  price: 9.5
outputs:
  username: body.echo.body.body.username
  age: body.echo.body.body.age
  active: body.echo.body.body.active
  city: body.echo.body.body.city
  missing_nickname: body.echo.body.body.missing_nickname
  literal_token: body.echo.body.body.literal_token
  literal_omit: body.echo.body.body.literal_omit
  angle_whole: body.echo.body.body.angle_whole
  quoted_angle: body.echo.body.body.quoted_angle
  angle_prefix: body.echo.body.body.angle_prefix
  angle_suffix: body.echo.body.body.angle_suffix
  angle_both: body.echo.body.body.angle_both
  quoted_curly: body.echo.body.body.quoted_curly
  curly_whole: body.echo.body.body.curly_whole
  text_slice: body.echo.body.body.text_slice
  missing_embed: body.echo.body.body.missing_embed
  attr_number: body.echo.body.body.item.number
  attr_bool: body.echo.body.body.item.flag
  attr_text: body.echo.body.body.item.version
  attr_angle: body.echo.body.body.item.angle
  attr_embedded: body.echo.body.body.item.embedded
  attr_literal: body.echo.body.body.item.literal
  attr_decimal: body.echo.body.body.item.decimal
  price_text: body.echo.body.body.price
  status_code: status
url: https://test.mmt.dev/echo/xml
method: post
format: xml
body:
  body:
    username: i:username
    age: i:age
    active: i:active
    city: i:city
    missing_nickname: i:nickname
    literal_token: "i:username"
    literal_omit: "omit"
    angle_whole: <<i:age>>
    quoted_angle: "<<i:username>>"
    angle_prefix: "asda<<i:username>>"
    angle_suffix: "<<i:age>>asas"
    angle_both: "asda<<i:active>>asas"
    quoted_curly: "{{i:username}}"
    curly_whole: {{i:city}}
    text_slice: <<i:city[0:3]>>
    missing_embed: "x<<i:nickname>>y"
    item:
      _attributes:
        number: i:age
        flag: i:active
        version: i:version
        angle: <<i:age>>
        embedded: "n<<i:age>>"
        literal: "1.0"
        decimal: i:price
    price: i:price
examples:
  - id: defaults
    title: Check outputs
    expect:
      status_code: 200
      username: i:username
      age: =S <<i:age>>
      active: =S <<i:active>>
      city: i:city
      missing_nickname: "i:nickname"
      literal_token: "i:username"
      literal_omit: "omit"
      angle_whole: =S <<i:age>>
      quoted_angle: i:username
      angle_prefix: "asdaalice"
      angle_suffix: "100asas"
      angle_both: "asdatrueasas"
      quoted_curly: i:username
      curly_whole: i:city
      text_slice: i:city[0:3]
      missing_embed: "xi:nicknamey"
      attr_number: "100"
      attr_bool: "true"
      attr_text: "1.0"
      attr_angle: "100"
      attr_embedded: "n100"
      attr_literal: "1.0"
      attr_decimal: "9.5"
      price_text: "9.5"
