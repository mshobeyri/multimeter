type: api
title: Random tokens in a form body
description: "Urlencoded fields are strings. r:int and r:bool are sent as text."
outputs:
  request_id: body.body.request_id
  lucky_number: body.body.lucky_number
  active: body.body.active
  missing_token: body.body.missing_token
  literal_token: body.body.literal_token
  literal_omit: body.body.literal_omit
  angle_whole: body.body.angle_whole
  quoted_angle: body.body.quoted_angle
  angle_prefix: body.body.angle_prefix
  angle_suffix: body.body.angle_suffix
  angle_both: body.body.angle_both
  quoted_curly: body.body.quoted_curly
  curly_whole: body.body.curly_whole
  status_code: status
url: https://test.mmt.dev/echo
method: post
format: urlencoded
body:
  request_id: r:uuid
  lucky_number: r:int(10,20)
  active: r:bool
  missing_token: r:not_a_token
  literal_token: "r:uuid"
  literal_omit: "omit"
  angle_whole: <<r:int(10,20)>>
  quoted_angle: "<<r:int(10,20)>>"
  angle_prefix: "asda<<r:int(10,20)>>"
  angle_suffix: "<<r:int(10,20)>>asas"
  angle_both: "asda<<r:bool>>asas"
  quoted_curly: "{{r:color}}"
  curly_whole: {{r:color}}
examples:
  - id: defaults
    title: Check outputs
    expect:
      status_code: 200
      request_id: != null
      lucky_number: =* [0-9]+
      active: =* true|false
      missing_token: "r:not_a_token"
      literal_token: "r:uuid"
      literal_omit: "omit"
      angle_whole: =* [0-9]+
      quoted_angle: =* [0-9]+
      angle_prefix: =* ^asda(1[0-9]|20)$
      angle_suffix: =* ^(1[0-9]|20)asas$
      angle_both: =* ^asda(true|false)asas$
      quoted_curly: =* [a-z]+
      curly_whole: =* [a-z]+

