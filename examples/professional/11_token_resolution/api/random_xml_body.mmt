type: api
title: Random tokens in an XML body
description: "XML element text is always a string, including r:int and r:bool."
outputs:
  request_id: body[/<request_id>(.*?)</request_id>/]
  lucky_number: body[/<lucky_number>(.*?)</lucky_number>/]
  active: body[/<active>(.*?)</active>/]
  missing_token: body[/<missing_token>(.*?)</missing_token>/]
  literal_token: body[/<literal_token>(.*?)</literal_token>/]
  literal_omit: body[/<literal_omit>(.*?)</literal_omit>/]
  angle_whole: body[/<angle_whole>(.*?)</angle_whole>/]
  quoted_angle: body[/<quoted_angle>(.*?)</quoted_angle>/]
  angle_prefix: body[/<angle_prefix>(.*?)</angle_prefix>/]
  angle_suffix: body[/<angle_suffix>(.*?)</angle_suffix>/]
  angle_both: body[/<angle_both>(.*?)</angle_both>/]
  quoted_curly: body[/<quoted_curly>(.*?)</quoted_curly>/]
  curly_whole: body[/<curly_whole>(.*?)</curly_whole>/]
  missing_embed: body[/<missing_embed>(.*?)</missing_embed>/]
  status_code: status
url: https://test.mmt.dev/echo
method: post
format: xml
body:
  request_id: r:uuid
  lucky_number: r:int(10,20)
  active: r:bool
  missing_token: r:not_a_token
  literal_token: "r:uuid"
  literal_omit: "omit"
  angle_whole: <<r:int(10,20)>>
  quoted_angle: "<<r:int(10,20)>>"
  angle_prefix: "asda<<r:int(10,20)>>"
  angle_suffix: "<<r:int(10,20)>>asas"
  angle_both: "asda<<r:bool>>asas"
  quoted_curly: "{{r:color}}"
  curly_whole: {{r:color}}
  missing_embed: "x<<r:not_a_token>>y"
examples:
  - id: defaults
    title: Check outputs
    expect:
      status_code: 200
      request_id: r:uuid
      lucky_number: r:int(10,20)
      active: r:bool
      missing_token: "r:not_a_token"
      literal_token: "r:uuid"
      literal_omit: "omit"
      angle_whole: r:int(10,20)
      quoted_angle: r:int(10,20)
      angle_prefix: =* ^asda(1[0-9]|20)$
      angle_suffix: =* ^(1[0-9]|20)asas$
      angle_both: =* ^asda(true|false)asas$
      quoted_curly: r:color
      curly_whole: r:color
      missing_embed: "xr:not_a_tokeny"
