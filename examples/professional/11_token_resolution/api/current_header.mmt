type: api
title: Current tokens in headers
description: "Header values are strings. c:epoch and c:git_dirty are sent as text digits / true|false."
outputs:
  day_name: body[headers][x-day-name]
  epoch_seconds: body[headers][x-epoch-seconds]
  city: body[headers][x-city]
  git_branch: body[headers][x-git-branch]
  git_commit: body[headers][x-git-commit]
  git_commit_short: body[headers][x-git-commit-short]
  git_describe: body[headers][x-git-describe]
  git_dirty: body[headers][x-git-dirty]
  missing_token: body[headers][x-missing-token]
  literal_token: body[headers][x-literal-token]
  literal_omit: body[headers][x-literal-omit]
  angle_whole: body[headers][x-angle-whole]
  quoted_angle: body[headers][x-quoted-angle]
  angle_prefix: body[headers][x-angle-prefix]
  angle_suffix: body[headers][x-angle-suffix]
  angle_both: body[headers][x-angle-both]
  quoted_curly: body[headers][x-quoted-curly]
  curly_whole: body[headers][x-curly-whole]
  text_slice: body[headers][x-text-slice]
  missing_embed: body[headers][x-missing-embed]
  status_code: status
url: https://test.mmt.dev/echo
method: get
headers:
  X-Day-Name: c:day
  X-Epoch-Seconds: c:epoch
  X-City: c:city
  X-Git-Branch: c:branch
  X-Git-Commit: c:commit
  X-Git-Commit-Short: c:commit_short
  X-Git-Describe: c:git_describe
  X-Git-Dirty: c:git_dirty
  X-Missing-Token: c:not_a_token
  X-Literal-Token: "c:day"
  X-Literal-Omit: "omit"
  X-Angle-Whole: <<c:epoch>>
  X-Quoted-Angle: "<<c:day>>"
  X-Angle-Prefix: "asda<<c:day>>"
  X-Angle-Suffix: "<<c:city>>asas"
  X-Angle-Both: "asda<<c:day>>asas"
  X-Quoted-Curly: "{{c:day}}"
  X-Curly-Whole: {{c:city}}
  X-Text-Slice: c:city[0:1]
  X-Missing-Embed: "x<<c:not_a_token>>y"
examples:
  - id: defaults
    title: Check outputs
    expect:
      status_code: 200
      day_name: c:day
      epoch_seconds: != null
      city: c:city
      git_branch: c:branch
      git_commit: c:commit
      git_commit_short: c:commit_short
      git_describe: c:git_describe
      git_dirty: c:git_dirty
      missing_token: "c:not_a_token"
      literal_token: "c:day"
      literal_omit: "omit"
      angle_whole: "=* ^[0-9]{10}$"
      quoted_angle: c:day
      angle_prefix: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)$
      angle_suffix: =$ asas
      angle_both: =* ^asda(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)asas$
      quoted_curly: c:day
      curly_whole: c:city
      text_slice: c:city[0:1]
      missing_embed: "xc:not_a_tokeny"
