type: env
title: Vault HTTP example defaults
description: |-
  Defaults for the local Vault KV mock. Override for a real Vault/OpenBao:
  vault_addr, vault_token, vault_secret_path.
variables:
  vault_addr:
    mock: http://localhost:9108
  vault_token:
    mock: root
  vault_secret_path:
    mock: mmt
  api_token:
    mock: ""
presets:
  runner:
    mock:
      vault_addr: mock
      vault_token: mock
      vault_secret_path: mock
      api_token: mock
