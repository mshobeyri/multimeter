{
  "name": "multimeter",
  "publisher": "mshobeyri",
  "displayName": "Multimeter – REST Client & API Testing",
  "description": "AI-powered REST Client and API testing in VS Code. Git-native alternative to Postman.",
	"version": "1.46.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/mshobeyri/multimeter.git"
  },
  "homepage": "https://mmt.dev",
  "icon": "res/logo.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:multimeter",
    "onChatParticipant:mmt"
  ],
  "main": "./dist/extension.js",
  "enabledApiProposals": [
    "chatProvider"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mmt",
        "extensions": [
          ".mmt"
        ],
        "aliases": [
          "MMT",
          "Multimeter Test"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "res/logo_file.svg",
          "dark": "res/logo_file.svg"
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "multimeter",
        "label": "Multimeter"
      }
    ],
    "chatInstructions": [
      {
        "path": "./rules/mmt-authoring.mdc"
      },
      {
        "path": "./rules/mmt-mcp.instructions.md"
      }
    ],
    "chatPromptFiles": [
      {
        "path": "./commands/edit-mmt-file.md"
      },
      {
        "path": "./commands/run-mmt-file.md"
      }
    ],
    "chatParticipants": [
      {
        "id": "multimeter",
        "name": "Multimeter",
        "fullName": "Multimeter Assistant",
        "description": "DEPRECATED: Use the Multimeter MCP server for test generation",
        "isSticky": true,
        "commands": [
          {
            "name": "run",
            "description": "Run a test or api @mmt /run <test path or api .mmt file path>"
          },
          {
            "name": "print-js",
            "description": "Print the generated JS code from a test @mmt /print-js <test path>"
          },
          {
            "name": "doc",
            "description": "Generate documentation from an API @mmt /doc <api .mmt file path>"
          },
          {
            "name": "help",
            "description": "Show help information about using Multimeter @mmt /help"
          }
        ]
      },
      {
        "id": "mmt",
        "name": "mmt",
        "fullName": "Multimeter Assistant",
        "description": "DEPRECATED: Use the Multimeter MCP server for test generation",
        "isSticky": false,
        "commands": [
          {
            "name": "run",
            "description": "Run a test or api @mmt /run <test path or api .mmt file path>"
          },
          {
            "name": "print-js",
            "description": "Print the generated JS code from a test @mmt /print-js <test path>"
          },
          {
            "name": "doc",
            "description": "Generate documentation from an API @mmt /doc <api .mmt file path>"
          },
          {
            "name": "help",
            "description": "Show help information about using Multimeter @mmt /help"
          }
        ]
      }
    ],
    "grammars": [
      {
        "language": "mmt",
        "scopeName": "source.mmt",
        "path": "./syntaxes/mmt.tmLanguage.json"
      }
    ],
    "icons": {
      "mmt-logo": {
        "description": "Multimeter logo",
        "default": {
          "fontPath": "./res/mmt-product-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "resourceLabelFormatters": [
      {
        "scheme": "mmt-temp",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "stripPathStartingSeparator": true,
          "workspaceSuffix": "temp"
        }
      }
    ],
    "configuration": {
      "title": "Multimeter",
      "properties": {
        "multimeter.body.auto.format": {
          "type": "boolean",
          "default": false,
          "description": "Automatically format the body of the responses"
        },
        "multimeter.body.lineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Show line numbers in API request/response body editors"
        },
        "multimeter.editor.fontSize": {
          "type": "number",
          "default": 12,
          "description": "Font size for the MMT YAML editor",
          "minimum": 8,
          "maximum": 40
        },
        "multimeter.editor.yamlPaneSize": {
          "type": "string",
          "default": "50%-50%",
          "enum": [
            "Only UI",
            "10%-90%",
            "20%-80%",
            "30%-70%",
            "40%-60%",
            "50%-50%",
            "60%-40%",
            "70%-30%",
            "80%-20%",
            "90%-10%",
            "Only YAML",
            "400px",
            "500px",
            "750px",
            "1000px",
            "1300px"
          ],
          "enumDescriptions": [
            "Show only the UI panel",
            "YAML 10% / UI 90%",
            "YAML 20% / UI 80%",
            "YAML 30% / UI 70%",
            "YAML 40% / UI 60%",
            "YAML 50% / UI 50%",
            "YAML 60% / UI 40%",
            "YAML 70% / UI 30%",
            "YAML 80% / UI 20%",
            "YAML 90% / UI 10%",
            "Show only the YAML editor",
            "YAML fixed at 400px",
            "YAML fixed at 500px",
            "YAML fixed at 750px",
            "YAML fixed at 1000px",
            "YAML fixed at 1300px"
          ],
          "description": "Default editor layout when opening MMT files. Percentage options are YAML%-UI%; Only YAML / Only UI hide one pane; px options fix the YAML pane width. Split button uses the selected split size (or 50%-50% if Only YAML / Only UI is selected)."
        },
        "multimeter.editor.collapseDescription": {
          "type": "boolean",
          "default": false,
          "description": "Automatically collapse multi-line description fields when opening MMT files"
        },
        "multimeter.workspaceEnvFile": {
          "type": "string",
          "default": "multimeter.mmt",
          "description": "Path to the workspace environment file (type: env) relative to the workspace root. This file is loaded on workspace open and sets environment variables, presets, and certificates."
        },
        "multimeter.showLogOnRun": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Multimeter log panel when running a test, API, or suite from the editor"
        },
        "multimeter.suite.reportSpillBytes": {
          "type": "number",
          "default": 2097152,
          "minimum": 0,
          "description": "When in-memory suite run reports exceed this many bytes, step details move to internal browser storage and load only when a report row is expanded. Set to 0 to disable."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "mmt.editor",
        "displayName": "MMT Editor",
        "selector": [
          {
            "filenamePattern": "file:/**/*.mmt"
          },
          {
            "filenamePattern": "untitled:/**/*.mmt"
          },
          {
            "filenamePattern": "mmt-temp:/**/*.mmt"
          },
          {
            "filenamePattern": "mmt-temp://**/*.mmt"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.mmt"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.mmt"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mmt.httpEditor",
        "displayName": "Multimeter HTTP Test Editor",
        "selector": [
          {
            "filenamePattern": "file:/**/*.http"
          },
          {
            "filenamePattern": "file:/**/*.https"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.http"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.https"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.http"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.https"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "mmt.brunoEditor",
        "displayName": "Multimeter Bruno Test Editor",
        "selector": [
          {
            "filenamePattern": "file:/**/*.bru"
          },
          {
            "filenamePattern": "file:/**/*.bruno"
          },
          {
            "filenamePattern": "file:/**/bruno.json"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.bru"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.bruno"
          },
          {
            "filenamePattern": "vscode-remote:/**/bruno.json"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.bru"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.bruno"
          },
          {
            "filenamePattern": "vscode-vfs:/**/bruno.json"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "mmt.specEditor",
        "displayName": "Multimeter Spec Editor",
        "selector": [
          {
            "filenamePattern": "file:/**/*.json"
          },
          {
            "filenamePattern": "file:/**/*.yaml"
          },
          {
            "filenamePattern": "file:/**/*.yml"
          },
          {
            "filenamePattern": "file:/**/*.xml"
          },
          {
            "filenamePattern": "file:/**/*.wsdl"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.json"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.yaml"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.yml"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.xml"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.wsdl"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.json"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.yaml"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.yml"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.xml"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.wsdl"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "multimeter.mmt.show",
        "title": "Show MMT Preview",
        "category": "Preview",
        "icon": {
          "light": "res/activity.png",
          "dark": "res/activity.png"
        }
      },
      {
        "command": "multimeter.mmt.show.yaml",
        "title": "Hide UI Preview",
        "icon": "$(layout-sidebar-right-dock)"
      },
      {
        "command": "multimeter.mmt.show.ui",
        "title": "Hide YAML Preview",
        "icon": "$(layout-sidebar-left-dock)"
      },
      {
        "command": "multimeter.mmt.show.full",
        "title": "Show Full Preview",
        "icon": "$(layout-centered)"
      },
      {
        "command": "multimeter.mmt.show.as.text",
        "title": "Open as Text",
        "category": "MMT",
        "icon": "$(code-oss)"
      },
      {
        "command": "multimeter.mmt.show.as.mmt",
        "title": "Open as MMT",
        "category": "MMT",
        "icon": {
          "light": "res/activity.png",
          "dark": "res/activity.png"
        }
      },
      {
        "command": "multimeter.apiTest.new",
        "title": "New Multimeter File",
        "category": "Multimeter",
        "icon": {
          "light": "res/activity.png",
          "dark": "res/activity.png"
        }
      },
      {
        "command": "multimeter.start.newRequest",
        "title": "New POST Request",
        "category": "Multimeter",
        "icon": "$(send)"
      },
      {
        "command": "multimeter.sendRequest",
        "title": "Send Request",
        "category": "Multimeter",
        "icon": "$(send)"
      },
      {
        "command": "multimeter.getStarted.reset",
        "title": "Reset Get Started",
        "category": "Multimeter"
      },
      {
        "command": "multimeter.history.clear",
        "title": "Clear History",
        "icon": "$(clear-all)"
      },
      {
        "command": "multimeter.setting.open",
        "title": "Open Multimeter Settings",
        "category": "Multimeter"
      },
      {
        "command": "multimeter.convert.toMmt",
        "title": "Convert to MMT...",
        "category": "Multimeter",
        "icon": "$(export)"
      },
      {
        "command": "multimeter.environment.focus",
        "title": "Focus Environment Variables",
        "category": "Multimeter"
      },
      {
        "command": "multimeter.environment.clear",
        "title": "Clear Environment Variables",
        "icon": "$(clear-all)"
      },
      {
        "command": "multimeter.environment.refresh",
        "title": "Refresh Environment Variables",
        "icon": "$(refresh)"
      },
      {
        "command": "multimeter.environment.loadFromFile",
        "title": "Load Environment from Workspace File",
        "category": "Multimeter",
        "icon": "$(cloud-download)"
      },
      {
        "command": "multimeter.connections.refresh",
        "title": "Refresh Connections",
        "icon": "$(refresh)"
      },
      {
        "command": "multimeter.connections.closeAll",
        "title": "Close All Connections",
        "icon": "$(trash)"
      },
      {
        "command": "multimeter.mock.server.copyAddress",
        "title": "Copy Server Address",
        "icon": "$(copy)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multimeter-activitybar",
          "title": "Multimeter",
          "icon": "res/activity.png"
        }
      ],
      "panel": [
        {
          "id": "multimeter-panel",
          "title": "Multimeter",
          "icon": "res/activity.png"
        }
      ]
    },
    "views": {
      "multimeter-activitybar": [
        {
          "id": "multimeter.activityDock",
          "name": "Views",
          "icon": "res/activity.png",
          "visibility": "collapsed",
          "order": 0
        },
        {
          "id": "multimeter.tempFiles",
          "name": "Temp Files",
          "icon": "res/activity.png",
          "type": "webview",
          "visibility": "visible",
          "order": 1
        },
        {
          "id": "multimeter.start",
          "name": "Get Started",
          "icon": "res/activity.png",
          "type": "webview",
          "visibility": "visible",
          "order": 2
        },
        {
          "id": "multimeter.mock.server",
          "name": "Mock Server",
          "icon": "res/activity.png",
          "type": "webview",
          "visibility": "collapsed",
          "order": 3
        },
        {
          "id": "multimeter.connections",
          "name": "Connections",
          "icon": "res/activity.png",
          "type": "webview",
          "visibility": "collapsed",
          "order": 4
        }
      ],
      "multimeter-panel": [
        {
          "id": "multimeter.environment",
          "name": "Environment Variables",
          "icon": "res/activity.png",
          "type": "webview",
          "order": 1
        },
        {
          "id": "multimeter.history",
          "name": "History",
          "icon": "res/activity.png",
          "type": "webview",
          "order": 2
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "multimeter.activityDock",
        "contents": "Drag Multimeter views onto this **Views** header to dock them in the Multimeter sidebar.\n\n[Open Environment Variables](command:multimeter.environment.focus)\n[Open History](command:multimeter.history.focus)"
      }
    ],
    "keybindings": [
      {
        "command": "multimeter.sendRequest",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "activeCustomEditorId == mmt.editor || activeCustomEditorId == mmt.httpEditor || activeCustomEditorId == mmt.brunoEditor || activeCustomEditorId == mmt.specEditor"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multimeter.history.clear",
          "when": "view == multimeter.history",
          "group": "navigation"
        },
        {
          "command": "multimeter.environment.refresh",
          "when": "view == multimeter.environment",
          "group": "navigation"
        },
        {
          "command": "multimeter.environment.clear",
          "when": "view == multimeter.environment",
          "group": "navigation"
        },
        {
          "command": "multimeter.connections.refresh",
          "when": "view == multimeter.connections",
          "group": "navigation"
        },
        {
          "command": "multimeter.connections.closeAll",
          "when": "view == multimeter.connections",
          "group": "navigation"
        },
        {
          "command": "multimeter.mock.server.copyAddress",
          "when": "view == multimeter.mock.server",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "multimeter.mmt.show.ui",
          "when": "activeCustomEditorId == mmt.editor || activeCustomEditorId == mmt.specEditor",
          "group": "navigation@10"
        },
        {
          "command": "multimeter.mmt.show.full",
          "when": "activeCustomEditorId == mmt.editor || activeCustomEditorId == mmt.specEditor",
          "group": "navigation@11"
        },
        {
          "command": "multimeter.mmt.show.yaml",
          "when": "activeCustomEditorId == mmt.editor || activeCustomEditorId == mmt.specEditor",
          "group": "navigation@12"
        },
        {
          "command": "multimeter.mmt.show.as.mmt",
          "when": "(resourceExtname == .mmt || resourceExtname == .http || resourceExtname == .https || resourceExtname == .bru || resourceExtname == .bruno || resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml || resourceExtname == .xml || resourceExtname == .wsdl) && activeCustomEditorId != mmt.editor && activeCustomEditorId != mmt.httpEditor && activeCustomEditorId != mmt.brunoEditor && activeCustomEditorId != mmt.specEditor",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "command": "multimeter.convert.toMmt",
          "when": "resourceExtname =~ /\\.(json|yaml|yml|xml|wsdl|http|https|bru|bruno)$/i",
          "group": "navigation@50"
        },
        {
          "command": "multimeter.mmt.show.as.text",
          "when": "resourceExtname == .mmt || resourceExtname == .http || resourceExtname == .https || resourceExtname == .bru || resourceExtname == .bruno",
          "group": "navigation@51"
        },
        {
          "command": "multimeter.mmt.show.as.mmt",
          "when": "resourceExtname == .mmt || resourceExtname == .http || resourceExtname == .https || resourceExtname == .bru || resourceExtname == .bruno || resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml || resourceExtname == .xml || resourceExtname == .wsdl",
          "group": "navigation@52"
        }
      ],
      "commandPalette": [
        {
          "command": "multimeter.apiTest.new"
        },
        {
          "command": "multimeter.start.newRequest"
        },
        {
          "command": "multimeter.getStarted.reset"
        },
        {
          "command": "multimeter.convert.toMmt"
        },
        {
          "command": "multimeter.mmt.show.as.text",
          "when": "resourceExtname == .mmt || resourceExtname == .http || resourceExtname == .https || resourceExtname == .bru || resourceExtname == .bruno"
        },
        {
          "command": "multimeter.mmt.show.as.mmt",
          "when": "resourceExtname == .mmt || resourceExtname == .http || resourceExtname == .https || resourceExtname == .bru || resourceExtname == .bruno || resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml || resourceExtname == .xml || resourceExtname == .wsdl"
        }
      ]
    }
  },
  "overrides": {
    "nth-check": "2.0.1",
    "postcss": "8.4.31",
    "webpack-dev-server": "5.3.0",
    "resolve-url-loader": "4.0.0",
    "glob": "^10.5.0",
    "js-yaml": "^4.1.1",
    "node-forge": "^1.3.2"
  },
  "keywords": [
    "rest-client",
    "thunder-client",
    "postman",
    "api-testing",
    "bruno",
    "http",
    "rest",
    "graphql",
    "grpc",
    "vscode",
    "openapi",
    "soap",
    "mock-server",
    "testing",
    "mcp",
    "cursor",
    "testlight",
    "ai"
  ],
  "license": "Apache-2.0",
  "workspaces": [
    "core",
    "mmtview"
  ],
  "scripts": {
    "buildcore": "npm run build --prefix core",
    "buildmcp": "npm run buildcore && npm run build --prefix mmtmcp && node scripts/copy-mcp-dist.mjs",
    "test:mcp": "npm run buildmcp && sh -c 'cd dist/mcp && NODE_PATH=./node_modules MMT_GUIDES_DIR=./guides npx @modelcontextprotocol/inspector node server.js'",
    "buildview": "npm run build --prefix mmtview",
    "bootstrap": "sh -c 'if [ -f package-lock.json ]; then npm ci; else npm install; fi; npm audit || true'",
    "buildcli": "npm run buildcore && npm run pkg --prefix mmtcli",
    "pack": "vsce package --readme-path EXTENSION.md --allow-package-all-secrets --allow-package-env-file",
    "pack-pre-release": "vsce package --pre-release --readme-path EXTENSION.md --allow-package-all-secrets --allow-package-env-file",
    "publish": "vsce publish --readme-path EXTENSION.md --allow-package-all-secrets --allow-package-env-file",
    "publish-ovsx": "node -e \"const v=require('./package.json').version; if (v.includes('-')) { console.error('Open VSX is stable-only'); process.exit(1); } require('child_process').execFileSync('npx',['--yes','ovsx','publish','./multimeter-'+v+'.vsix'],{stdio:'inherit'})\"",
    "vscode:prepublish": "npm run build:vendor && npm run package",
    "compile": "npm run buildcore && npm run buildmcp && npm run buildview && npm run build --prefix mmtcli && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "build:vendor": "npm run build --prefix core && npm run buildmcp && npm run build --prefix mmtview && rm -rf dist/core dist/mmtview && cp -R core/dist dist/core && cp -R mmtview/build dist/mmtview",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageProvider=v8 --coverageReporters=text-summary --coverageReporters=json-summary",
    "coverage:badge": "node scripts/update-coverage-badge.mjs",
    "test:ai-eval": "jest core/src/util/aiScaffoldEval.test.ts core/src/api-edit/suggestAssertions.test.ts core/src/util/testScaffold.test.ts --silent",
    "website": "npm run dev --prefix website",
    "cursor:validate-plugin": "node scripts/validate-cursor-plugin.mjs",
    "sync-versions": "node scripts/sync-versions.mjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "20.x",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ajv": "^8.17.1",
