# VS Code project settings
.vscode/**
.vscode-test/**

# Folders
bin/
docs/
src/
core/**
mmtcli/
out/
examples/
screenshots/
website/
demos/
playwright-demo/
AI/
.github/
.cursor-plugin/**
mcp.json

# Webview sources (runtime uses mmtview/build only)
mmtview/**
!mmtview/build/**

# Vendor copies under dist/ (extension uses dist/extension.js + dist/mcp)
dist/core/**
dist/mmtview/**
dist/extension.js.map

# Test folders
**/test/**
**/tests/**
**/__tests__/**
*.test.*

# Dependencies (will be bundled, not shipped raw)
node_modules/**
**/node_modules/**
# MCP server runtime deps live under dist/mcp/node_modules (not bundled)
!dist/mcp/node_modules/**
dist/mcp/node_modules/**/*.md
dist/mcp/node_modules/**/*.d.ts
dist/mcp/node_modules/**/src/**
dist/mcp/node_modules/**/test/**
dist/mcp/node_modules/**/tests/**

# MCP build sources (shipped artifact is dist/mcp/)
mmtmcp/**

# Local Cursor MCP config (not for VS Code extension users)
.cursor/**

# Git & dev files
.gitignore
.gitattributes
.dockerignore
**/.git
**/.DS_Store
*.code-workspace

