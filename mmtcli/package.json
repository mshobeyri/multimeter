{
  "name": "mmt-testlight",
  "version": "1.42.3-pre",
  "description": "AI-powered REST Client and Git-native API testing CLI for YAML .mmt files. Same tests in VS Code and CI. Alternative to Postman.",
  "license": "Apache-2.0",
  "private": false,
  "homepage": "https://mmt.dev/docs/features/testlight/install",
  "repository": {
    "type": "git",
    "url": "https://github.com/mshobeyri/multimeter.git",
    "directory": "mmtcli"
  },
  "bugs": {
    "url": "https://github.com/mshobeyri/multimeter/issues"
  },
  "keywords": [
    "api-testing",
    "rest-client",
    "cli",
    "ci",
    "yaml",
    "postman-alternative",
    "testlight",
    "multimeter",
    "mcp"
  ],
  "bin": {
    "testlight": "dist/cli.js",
    "mmt": "dist/cli.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "node esbuild.mjs",
    "build:tsc": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:pkg-bundle": "node esbuild.pkg.mjs",
    "dev": "tsx src/cli.ts --help",
    "clean": "rimraf dist",
    "pkg": "rimraf dist-cjs && npm run build:pkg-bundle && bash ../scripts/build-binaries.sh",
    "test": "echo \"(no tests yet)\""
  },
  "pkg": {
    "compress": "Brotli",
    "assets": [
      "node_modules/@grpc/grpc-js/**",
      "node_modules/@grpc/proto-loader/**",
      "../node_modules/@grpc/grpc-js/**",
      "../node_modules/@grpc/proto-loader/**",
      "../core/node_modules/@grpc/grpc-js/**",
      "../core/node_modules/@grpc/proto-loader/**"
    ]
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "yaml": "^2.7.0",
    "xml-js": "^1.6.11",
    "axios": "^1.10.0",
    "ws": "^8.18.3",
    "node-forge": "^1.3.2"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.30",
    "@yao-pkg/pkg": "^6.22.0",
    "pe-library": "^2.0.1",
    "png-to-ico": "^2.1.8",
    "resedit": "^3.1.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.2"
  }
}
